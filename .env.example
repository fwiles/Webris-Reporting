# Windsor.ai REST API key (Settings → API in your Windsor dashboard)
WINDSOR_API_KEY=

# Anthropic API key — used to generate the daily "Webris Notes" summary
ANTHROPIC_API_KEY=

# Shared secret protecting /api/cron/refresh. Vercel Cron sends it as a Bearer token.
# Generate any long random string. Vercel also auto-injects CRON_SECRET for its own cron calls.
CRON_SECRET=

# Vercel KV (Upstash Redis) connection — auto-populated by `vercel env pull` after you
# create a KV store in the Vercel dashboard and link it to this project.
KV_REST_API_URL=
KV_REST_API_TOKEN=
